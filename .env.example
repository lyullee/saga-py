# 새로 발급한 Service Hub 키를 입력하세요. 노출된 키는 폐기하고 사용하지 마세요.
OPEN_AI_SERVICE_HUB_API_KEY=your_new_development_key
SAGA_SERVICE_HUB_BASE_URL=https://open.hasa.re.kr/v1

# Groq API를 수동 선택할 때만 사용합니다. 자동 전환은 하지 않습니다.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_DIRECT_MODEL=qwen/qwen3.8-27b

# Service Hub 모델 카탈로그의 Model ID를 사용합니다.
SAGA_MODEL=gpt-oss-20b
SAGA_FAST_MODEL=gpt-oss-20b
SAGA_DIRECT_MODEL=llama-3.3-70b
SAGA_VISION_MODEL=qwen2.5-vl-72b
SAGA_REASONING_EFFORT=low
# Keep localhost by default. Set 0.0.0.0 only behind appropriate access controls.
SAGA_HOST=127.0.0.1
SAGA_PORT=8090

# 기존 PDF 디렉터리를 그대로 사용합니다.
SAGA_UPLOAD_DIR=saga-uploads
SAGA_DATA_DIR=data
SAGA_DATABASE_PATH=data/saga.db

# 검색/답변 조절값
SAGA_RETRIEVAL_LIMIT=32
SAGA_CONTEXT_LIMIT=24
SAGA_MAX_CONTEXT_CHARS=42000
# FTS5 + 로컬 벡터 혼합 검색. 문제 분석 시 false로 두고 비교할 수 있습니다.
SAGA_HYBRID_SEARCH_ENABLED=true
SAGA_VECTOR_MODEL=hash-ngram-v1
# 생성된 답변을 한 번 더 LLM에 보내 근거·어조·누락을 점검합니다.
SAGA_ANSWER_REVIEW_ENABLED=true
# 비워 두면 빠른 모델(SAGA_FAST_MODEL)로 검증해 응답 지연을 줄입니다.
SAGA_ANSWER_REVIEW_MODEL=
# UI에서 선택하지 않은 API 요청의 기본 답변 길이: concise / standard / detailed / very_detailed
SAGA_ANSWER_LENGTH=standard
SAGA_ADMIN_TOKEN=

# 국가법령정보센터 Open API (국가법령 본문을 로컬 PDF로 변환할 때 사용)
# open.law.go.kr에서 발급받은 OC 값을 입력하세요. LLM API 키와 다릅니다.
SAGA_LAW_API_OC=
SAGA_LAW_API_BASE_URL=https://www.law.go.kr/DRF
SAGA_LAW_API_TIMEOUT=30
# 기본값은 saga-uploads이며, 생성된 법령 PDF도 기존 문서와 같은 라이브러리에 표시됩니다.
SAGA_LAW_PDF_DIR=saga-uploads
# 공개 NREL PDF와 HIAD 원본 XLSX를 저장하는 디렉터리
SAGA_EXTERNAL_DATA_DIR=data/external
